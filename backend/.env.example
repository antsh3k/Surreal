# Surreal Backend Configuration
# Copy this file to .env and fill in your actual API keys

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Brave Search API
BRAVE_API_KEY=your_brave_api_key_here

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/surreal?retryWrites=true&w=majority

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Origins (comma-separated for production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Active Inference Parameters
UNCERTAINTY_THRESHOLD=0.3
PREFERENCE_LEARNING_RATE=0.1
FREE_ENERGY_WEIGHT_DIVERGENCE=0.5
FREE_ENERGY_WEIGHT_ENTROPY=0.5

# Gemini Model Configuration
GEMINI_MODEL=gemini-1.5-pro
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048

# Search Configuration
BRAVE_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=10
